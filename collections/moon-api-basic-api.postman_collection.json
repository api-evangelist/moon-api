          "id": "cd436828-b161-4ca1-b471-49e99cf23790",
          "name": "Get basic moon phase information",
          "request": {
            "name": "Get basic moon phase information",
            "description": {
              "content": "Returns simplified moon phase data with phase name, stage, and days until next phases. Lat/lon are optional and default to London coordinates (51.5074, -0.1278). Backwards compatible.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "basic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "51.5074",
                  "description": "Latitude coordinate (-90 to 90). Optional, defaults to 51.5074 (London, UK)"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "-0.1278",
                  "description": "Longitude coordinate (-180 to 180). Optional, defaults to -0.1278 (London, UK - west is negative)"
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "Unix timestamp (optional, defaults to current time)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
